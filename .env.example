# Google SMTP Configuration for Portfolio Contact Form
# -------------------------------------------------------------
# 1. Ensure 2-Step Verification is enabled on your Google Account:
#    https://myaccount.google.com/security
# 2. Create an App Password at:
#    https://myaccount.google.com/apppasswords
#    (Name it e.g. "Portfolio Website")
# 3. Paste your 16-character generated password into SMTP_PASS below.
# -------------------------------------------------------------

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=richardbmelath@gmail.com
SMTP_PASS=
SMTP_TO=richardbmelath@gmail.com
